MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=notes_app_db

# Generate a long random value before deploying. Do not commit your real secret.
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email verification (required for new signups and password recovery).
# Use the mailbox's SMTP authorization/app password rather than its web login password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USERNAME when empty.
SMTP_FROM=
# Port 465: SSL=true, STARTTLS=false; port 587: SSL=false, STARTTLS=true.
SMTP_SSL=true
SMTP_STARTTLS=false

# Independent Shopkeeper Brain query service (import service must use another port).
RAG_AGENT_URL=http://127.0.0.1:8001
RAG_AGENT_TIMEOUT_SECONDS=180
RAG_INDEX_TIMEOUT_SECONDS=600

# Validated DAS3H JSON; unset/invalid/unvalidated files use Beta-Binomial fallback.
REVIEW_RISK_MODEL_PATH=

# PDF drafts and cropped images must stay available after confirming the import.
# Empty/unset uses .data/pdf-imports inside this project.
# PDF_IMPORT_STORAGE_DIR=G:/notes-data/pdf-imports
PUBLIC_NOTES_API_URL=http://localhost:8000

# Official site downloads: leave empty until the Windows packages are published.
# Accepts an https:// URL or an absolute path on this domain, e.g. /releases/setup.exe.
VITE_WINDOWS_DOWNLOAD_URL=
VITE_WINDOWS_PORTABLE_URL=
